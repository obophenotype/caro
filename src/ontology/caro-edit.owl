AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00040000> <http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00040000> "For image, see doi:10.1371/journal.pbio.1000461.g002.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00040001> "A synaptic neuropil block that lies anterior and lateral to the central complex, with which it is closely associated. Unlike components of the central complex, it is not separated from surrounding neuropils by a glial sheath.")
