AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110019> "FBbt:00110019")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00110019> <http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110019> "This neuron was indirectly shown to be olfactory by recording calcium changes in the antennal lobe during an odorant-response assay using wildtype flies and mutants in which ORN Ir64a were silenced (Ai et al., 2010).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134722") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0135850") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110020> "Serotonergic neuron of the dorso-posterior tip of the thoracico-abdominal ganglion with a large cell body. It fasciculates posteriorly with the abdominal nerve trunk and it branches to innervate the testicular ducts, the seminal vesicle, the accessory glands and the anterior ejaculatory duct (Lee et al., 2001). The cell bodies of these neurons are arranged as a cluster of 8 cells at the dorsal tip of the thoracico-abdominal ganglion (Lee and Hall, 2001).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00110020> "mmc46")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00110020> "2011-11-17T12:36:05Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134722") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110020> "s-Abg")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110020> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110020> "FBbt:00110020")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110020> "These neurons have not been found in females. The synaptic terminals were identified with a synaptotagmin staining (Lee et al., 2001).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0187906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206496") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110021> "Coeloconic olfactory sensillum of the antenna that is innervated by three olfactory receptor neurons (ORN). It is distinguishable from ac1, ac3 and ac4 by its odor response profile (Yao et al., 2005) and the identity of the ORNs that innervate it (Benton et al., 2009).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00110021> "mmc46")
