AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055900") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0073294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0084809") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB7-1.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001380> "Neuroblast NB7-1 is the largest neuroblast lineage generating 40 cells or more, including the U motorneurons and a large number of local interneurons. It also frequently generates the putative segment boundary cells (http://www.neuro.uoregon.edu/doelab/lineages/NB7-1.html).")
