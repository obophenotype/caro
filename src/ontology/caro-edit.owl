AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007143> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007143> "FBbt:00007143")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064798") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007144> "An ommatidial precursor cluster containing 5 prospective photoreceptors and 1-2 mystery cells. The definitive 5 cell ommatidial precluster is formed when these mystery cells are expelled from this structure and join the surrounding undifferentiated epithelium.")
