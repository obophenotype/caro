AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0208427") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100218> "A dopaminergic neuron whose cell body is located in a cluster of approximately 6-8 cell bodies in the cortex of the superior posterior slope.")
