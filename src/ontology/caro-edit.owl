AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110067> "FBbt:00110067")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206213") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0213020") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110068> "Distal medullary amacrine neuron that branches extensively in medulla layer M6  and extends small centrifugal processes to medulla layer M4 (Gao et al., 2008, Hasegawa et al., 2011). In medulla layer M6, it is postsynaptic to photoreceptor cell R7 and presynaptic to Tm5. It also makes synaptic contacts with Tm9 (in M4) (Gao et al., 2008).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00110068> "mmc46")
