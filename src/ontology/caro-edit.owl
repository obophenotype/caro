AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00001322> "FBbt:00001321")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001322> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0054242") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001322> "EGM1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001322> "FBbt:00001322")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001322> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001322> "This term comes from Klambt and Goodman, 1991 (FBrf0054242) who distinguished anterior, medial1 and medial2 exit glia based on position. But von Hilchen et al, 2008 (FBrf0204826) have shown that, when classified by lineage and expression, the relative position of these three cells is variable. We have therefore obsoleted this term.  As it is not possible to specify a 1:1 mapping between the nomenclature of Klambt and Goodman and that of von Hilchen, we suggest using the general term 'PNS exit glial cell'.")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FBbt_00001322> "true"^^xsd:boolean)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00001323> "FBbt:00001321")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001323> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0054242") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001323> "EGM2")
