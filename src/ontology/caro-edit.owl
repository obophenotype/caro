AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055900") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076117") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001383> "A neuroblast delaminating in the second wave of neuroblast delamination from the ventral neuroectoderm. This stage begins in embryonic stage 9 ending in stage 10, and the neuroblasts primarily delaminate into the intermediate column (Doe, 1992).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001383> "fly_anatomy.ontology")
