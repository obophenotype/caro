AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00084745> "see Fig 7 of Bryant, 1975 for location based on specification map.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00084751> "Subdivision of a wing vein along its length.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00084751> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00084751> "FBbt:00084751")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00085378> "A subdivision of the wing margin along its length.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00085378> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00085378> "margin")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00085378> "FBbt:00085378")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00085378> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0083230") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100000> "Scolopidial (mechanosensory) neuron of Johnston's organ. Its axon innervates the antennal mechanosensory and motor center.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100000> "2009-11-02T05:06:31Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100000> "JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100000> "Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100000> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100000> "FBbt:00100000")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100000> "Believed to be cholinergic on the basis of expression of a (ChAT)-lacZ fusion gene (Kitamoto et al., 1995).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0187921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100001> "Bundle formed from the fasciculated axons of the Johnston's organ neurons (JONs) within the antennal nerve (AN). The JONs form two bundles (dorsolateral and medioventral) within the antennal nerve by the point it reaches the base of antennal segment 1 (a1/scape). Shortly before entering the brain, these two bundles combine and spread over a large area of the AN cross-section. Upon entering the brain, the JONs predominantly occupy the ventral part of the AN. At the ventrolateral side of the antennal lobe, the bundle bifurcates. One side of the bifurcation gives rise to the main trunk of the antennal mechanosensory and motor center (AMMC). The other side defasciculates and innervates zone A of the AMMC.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100001> "2009-11-02T05:06:31Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100001> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0187921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100001> "JON nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100001> "Johnston organ nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100001> "Johnston organ neuron nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100001> "Johnston's organ nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100001> "Johnston's organ neuron nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100001> "FBbt:00100001")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100002> "Johnston's organ neuron (JON) activated by near-field sound ranging from 19 Hz to 952 Hz, maximally at 90dB (Kamikouchi et al., 2009; Yorozu et al., 2009). Cells preferentially activated by low-frequency vibration are loosely distributed as a ring in the middle layer of JON cell bodies. Higher frequencies preferentially activate JON neurons with cell bodies likely located mainly in the inner layer, directly surrounding the antennal nerve (Kamikouchi et al., 2006). These neurons are also transiently activated by the onset and offset of arista displacement.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100002> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100002> "2009-11-03T11:35:09Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100002> "sound activated Johnston's organ neuron")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100002> "vibration sensitive JON")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100002> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100002> "FBbt:00100002")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100002> "Response to sound and arista displacement determined electrophysiologically and using the calcium sensor GCaMP (Yorozu et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100003> "Johnston's organ neuron (JON) that is tonically activated by aristal deflection and is necessary for normal gravitaxis behaviour. These neurons form a broad 'ring' in the medial and outer layers of the JON array (Kamikouchi et al., 2009).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100003> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100003> "2009-11-03T11:46:28Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100003> "gravity sensitive Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100003> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100003> "deflection sensitive neurons")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100003> "gravity sensing neurons")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100003> "FBbt:00100003")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100003> "This neuron remains active as long as aristal deflection is maintained, as determined electrophysiologically and with intracellular calcium sensors (Kamikouchi et al., 2009). Evidence for role in gravitaxis behaviour comes from silencing of subsets of JO neurons using targeted expression of tetanus toxin (Kamikouchi et al., 2009). This class of JON may overlap with the wind sensitive JON.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100004> "Johnston's organ neuron (JON) tonically activated by arista deflection and required for 'wind-induced suppression of locomotion' behaviour (WISL; Yorozu et al., 2009). The cell bodies of these neurons form a broad ring in the medial and outer layers of the JON array (Kamikouchi et al., 2006).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100004> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100004> "2009-11-03T12:01:36Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100004> "wind sensitive Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100004> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100004> "deflection sensitive neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100004> "FBbt:00100004")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100005> "The main trunk (MT) of antennal mechanosensory and motor center (AMMC) is one of two bundles formed by the initial bifurcation of the Johnston's organ nerve projection, ventro-laterally to the antennal lobe. The second, more lateral bundle forms the anterior portion of AMMC zone A. The MT progresses posteriorly and exhibits a second bifurcation that gives rise to the bundle forming AMMC zone B. A final posterior MT bifurcation gives rise to the AMMC lateral core and EA bundle. The MT is devoid of presynaptic sites.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100005> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100005> "2009-12-04T02:17:06Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100005> "VFB:FBbt_00100005")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk of AMMC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100005> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "MT")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk of JON bundle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100005> "FBbt:00100005")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100005> "That the MT lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization. It is this lack of presynaptic sites which is used to distinguish the MT from the branches of the anterior portion of Zone A and zone B which are syntaxin- and synaptobrevin-positive (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100006> "Bundle, devoid of presynaptic sites, formed from one branch of the final, most posterior bifurcation of the antennal mechanosensory and motor center (AMMC) main trunk (MT). The other side of the bifurcation gives rise to the lateral core of the AMMC (LC). It is directly connected to zone E of the AMMC and consists of the projections of zone E Johnston's organ neurons.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100006> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100006> "2009-12-04T03:18:13Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100006> "VFB:FBbt_00100006")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "EA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "EA bundle of AMMC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "anterior region of bundle e")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "anterior region of zone E")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100006> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100006> "FBbt:00100006")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100006> "DISAMBIGUATION: Kamikouchi et al., 2006, refer to this as part of zone E, however we use AMMC zone E to refer only to the synapse rich region anterior to the EA. Evidence that EA bundle of AMMC lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100007> "Neuron projection bundle containing the axons of Johnston's organ neurons (JONs) that arises from the final, most posterior bifurcation of the main trunk of the antennal mechanosensory and motor center (AMMC). (The other bundle arising from this bifurcation is the EA region of the AMMC). The lateral core is devoid of presynaptic sites. It terminates in a bifurcation that gives rise to the synapse rich AMMC zones C and D.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100007> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100007> "2009-12-04T04:01:02Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100007> "VFB:FBbt_00100007")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100007> "LC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100007> "lateral core of AMMC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100007> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100007> "FBbt:00100007")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100007> "That the lateral core of AMMC lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100008> "Johnston's organ neuron that innervates zone A of the antennal mechanosensory and motor center (AMMC). The cell bodies of these neurons are located mainly in the inner layer of Johnston's organ, directly surrounding the antennal nerve.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100008> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100008> "2009-12-07T12:53:56Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100008> "zone A JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100008> "zone A Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100008> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100008> "FBbt:00100008")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100008> "Cell body location determined by enhancer trap expression (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100009> "Johnston's organ neuron that innervates zone B of the antennal mechanosensory and motor center (AMMC). The cell bodies of zone B Johnston organ neurons are distributed as a ring in the middle layer of cells within the Johnston's organ (Kamikouchi et al., 2006).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100009> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100009> "2009-12-07T12:56:54Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100009> "zone B JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100009> "zone B Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100009> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100009> "FBbt:00100009")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100009> "Cell body location determined by enhancer trap expression (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100010> "Johnston's organ neuron that innervates zone C of the antennal mechanosensory and motor center (AMMC). The cell bodies of these neurons are co-mingled with those of zone E Johnston organ neurons, forming a broad ring mainly in the medial and outer layers of the Johnston's organ.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100010> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100010> "2009-12-07T12:58:42Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100010> "zone C JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100010> "zone C Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100010> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100010> "FBbt:00100010")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100010> "Cell body location determined by enhancer trap expression (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100011> "Johnston's organ neuron whose response is activated by small, bi-directional displacements of the antenna.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100011> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100011> "2009-11-20T01:06:20Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100011> "Johnston's organ neuron phasically activated by arista deflection")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100011> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100011> "FBbt:00100011")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100011> "May or may not be the same as 'sound activated Johnston's organ neuron' (FBbt:00100002).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100012> "Johnston's organ neuron whose response is maintained so long as unidirectional aristal deflection is sustained.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100012> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100012> "2009-11-20T01:45:16Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100012> "Johnston's organ neuron tonically activated by arista deflection")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100012> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100012> "FBbt:00100012")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100013> "Johnston's organ neuron tonically activated by posterior arista deflection and required for wind-induced suppression of locomotion behaviour (WISL; Yorozu et al., 2009). These neurons project to zone E of the antennal mechanosensory and motor center.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100013> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100013> "2009-11-20T02:13:55Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100013> "Johnston's organ neuron activated by tonic posterior arista deflection")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100013> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100013> "FBbt:00100013")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100013> "Calcium sensor (GCaMP) studies show strong activity of AMMC zone E when antenna is displaced either by wind application to the front of the head (or at 45 degrees to the front), or by mechanical manipulation. No activation of zone C or other zones is observed (Yorozu et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100014> "Johnston's organ neuron tonically activated by anterior arista deflection and required for wind-induced suppression of locomotion behaviour (WISL; Yorozu et al., 2009). These neurons project to zone C of the antennal mechanosensory and motor center.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100014> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100014> "2009-11-20T02:38:05Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100014> "Johnston's organ neuron activated by tonic anterior arista deflection")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100014> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100014> "FBbt:00100014")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100014> "Calcium sensor (GCaMP) studies show strong activity of AMMC zone C when antenna is displaced either by wind application to the rear of the head or by mechanical manipulation. No activation of zone E or other zones is observed (Yorozu et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100015> "Antennal mechanosensory and motor center zone A is a synapse rich sub-region of the antennal mechanosensory and motor center (AMMC) formed from bifurcation of the Johnston's organ bundle. (The other structure arising from this bifurcation is the main trunk of the AMMC (MT)). Zone A is rich in presynaptic sites of Johnston's organ neurons. It is phasically activated by pulse song (between 19-952Hz, 90dB), with the strongest activation by higher-frequency vibrations (Kamikouchi et al., 2009). The cell bodies of zone A Johnston organ neurons are located mainly in the inner layer of Johnston's organ, directly surrounding the antennal nerve (Kamikouchi et al., 2006).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100015> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100015> "2009-11-23T04:02:08Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100015> "VFB:FBbt_00100015")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100015> "AMMC zone A")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100015> "antennal mechanosensory and motor center zone A")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100015> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100015> "zone A")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100015> "FBbt:00100015")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100015> "Presence of presynaptic sites of Johnston's organ neurons determined by immunoreactivity to syntaxin and synaptobrevin::GFP localization (Kamikouchi et al., 2006). Sound activation of zone A was determined by GCaMP-based studies (Kamikouchi et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100016> "Antennal mechanosensory and motor center Zone B is a synapse rich sub-region of the antennal mechanosensory and motor center (AMMC) formed from the first bifurcation of the AMMC main trunk. It is rich in presynaptic sites of Johnston's organ neurons (JONs). It is phasically activated by pulse song (between 19-952Hz, 90dB), with stronger activation by the low-frequency vibrations (Kamikouchi et al., 2009).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100016> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100016> "2009-11-23T04:02:36Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100016> "VFB:FBbt_00100016")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100016> "AMMC zone B")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100016> "antennal mechanosensory and motor center zone B")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100016> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100016> "zone B")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100016> "FBbt:00100016")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100016> "Presence of presynaptic sites determined by immunoreactivity to syntaxin and synaptobrevin::GFP localization (Kamikouchi et al., 2006). Sound activation of zones was determined by GCaMP-based studies (Kamikouchi et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100017> "Antennal mechanosensory and motor center zone C is a synapse rich sub-region of the antennal mechanosensory and motor center (AMMC) that arises from the most lateral half of the bifurcation that terminates the lateral core (lc) bundle. (The other half of the bifurcation forms zone D). It is rich in the presynapses of Johnston's organ neurons (JONs) (Kamikouchi et al., 2006). Zone C JONs respond to anterior directed aristal deflection (Yorozu et al., 2009), and are also involved in gravitaxis (Kamikouchi et al., 2009).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100017> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100017> "2009-11-23T04:03:08Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100017> "VFB:FBbt_00100017")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100017> "AMMC zone C")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100017> "antennal mechanosensory and motor center zone C")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100017> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100017> "zone C")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100017> "FBbt:00100017")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100017> "Presence of presynaptic sites determined by immunoreactivity to syntaxin and synaptobrevin::GFP localization (Kamikouchi et al., 2006). Activation of zone C Johnston organ neurons through aristal deflection determined by GCaMP studies (Yorozu et al., 2009, Kamikouchi et al., 2009).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100018> "Antennal mechanosensory and motor center zone D is a synapse rich sub-region of the antennal mechanosensory and motor center (AMMC) that arises from the bifurcation that terminates the lateral core bundle. (The other half of the bifurcation forms zone C). It is rich in the presynapses of Johnston's organ neurons (JONs) (Kamikouchi et al., 2006).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100018> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100018> "2009-11-23T04:03:53Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100018> "VFB:FBbt_00100018")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100018> "AMMC zone D")
