AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0148966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSdescription.html#vdap") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSorganization0.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00002525> "Class I dendritic arborizing neuron of larval segments A1-7. Its cell body is located in the ventral cluster of sense organs and is the most posteriorly located of the multidendritic neurons found in these segments. Fasciculates in branch c of the abdominal segmental nerve, SNc (Campos-Ortega and Hartenstein, 1997).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0148966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSnomenclature0.html") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00002525> "vpda")
