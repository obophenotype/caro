AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110046> "Tachykinin expression was observed by in situ hybridization and immunostaining (Winther et al., 2003).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0162212") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110047> "Adult neuron that expresses tachykinin (FBgn0037976) and whose cell body is located at the base of the optic lobe. There are about 10 pairs of cell bodies per hemisphere (Winther et al., 2003).")
