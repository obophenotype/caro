AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110103> "FBbt:00110103")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110103> "Naming of sensilla is based on figure 1A of Weiss et al., (2011). There is no correspondence in Hiroi et al., (2002). Note that both Shanbhag et al., (2001) and Hiroi et al., (2002) claim there are between 9 and 10 I-type sensilla present.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204826") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110104> "Embryonic peripheral glial cell associated with the intersegmental nerve (ISN). It is the most medially located peripheral glial cell, close to the transition zone between the CNS and the PNS (exit area). It develops from neuroblast 1-3 (von Hilchen et al., 2008).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00110104> "mmc46")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00110104> "2012-01-19T03:05:09Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204826") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110104> "ePG1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110104> "fly_anatomy.ontology")
