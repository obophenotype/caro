AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00045037> "FBbt:00045037")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00045037> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00045037> <http://purl.obolibrary.org/obo/fbbt#BrainName_Embargo>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00045037> "The name crepine is used in French cuisine to refer to a slice of meat wrapped around some delicacy.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00045039") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00045039> "Thin, elongated, antler-shaped, bilaterally paired synaptic neuropil domain spanning from the inferior bridge to the inferior edge of the superior lateral protocerebrum. It runs through the space between the protocerebral bridge and the fan-shaped body, along the medial surface of the inner antenno-cerebral tract.")
