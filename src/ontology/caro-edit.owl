AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007400> "FBbt:00007400")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0051437") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0107836") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00007401") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem1.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007401> "The adult antennal lobe is a bilaterally paired synaptic neuropil domain of the deuterocerebrum lying in front of the protocerebral synaptic neuropil domains. It is divided into approximately 50 glomeruli and is clearly separated from adjacent neuropil domains by an extensive glial sheath. The two antennal lobes are connected by the antennal commissure and receive olfactory receptor neuron axons from the antennal nerve and subesophageal tract. It is also connected to the antenno-cerebral tracts and the broad root.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00007401> "2009-12-14T10:59:28Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007401> "VFB:FBbt_00007401")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007401> "AL")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007401> "adult olfactory lobe")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007401> "fly_anatomy.ontology")
