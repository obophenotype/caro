AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0065419") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-3-540-07343-7") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007427> "A large midline-crossing commissure connecting the medulla of each brain hemisphere, passing dorsal to the esophageal foramen (Helfrich-Forster and Homberg, 1993).")
