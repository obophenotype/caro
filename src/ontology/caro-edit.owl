AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:gg") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-3-11-014898-5") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003701> "A region of the adult brain that processes visual information from the compound eyes.")
