AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205263") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007482> "Tract that connects the antennal lobe to the mushroom body calyx and whose trajectory runs between the inner and outer antenno-cerebral tracts.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205263") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007482> "imACT")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007482> "medial-mediolateral antenno-protocerebral tract")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007482> "mmlAPT projection neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007482> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007482> "FBbt:00007482")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007482> "Perhaps too minor to be considered a tract? Tanaka et al., 2008, only identify two neuron classes that follow this path.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0051437") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205263") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007483> "Multiglomerular antennal lobe projection neuron that fasciculates with the inner-medial antenno-cerebral tract. The cell body is located lateral to the antennal lobe, and projects between the inner antenno-cerebral tract and the mlAPT, before turning laterally at the level of the fan-shaped body towards the pedunculus. The axon enters the pedunculus where it turns posteriorly and bifurcates in the mushroom body calyx. One branch terminates in the calyx whilst the other further bifurcates and terminates in the lateral horn. Other branches innervate the subesophageal ganglion.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00007483> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00007483> "2010-09-09T01:53:43Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205263") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007483> "imACT PN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007483> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007483> "FBbt:00007483")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007483> "Tanaka et al., (2008) describe imACT projection neurons that innervate the following antennal lobe glomeruli: DC1, DL2v, DL5, DM1, DM2, DM3, DM4, DP1lm, V, VC1, VC3l, VL1, VM7 and VP1-3, though this is based on unpublished data.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007484> "An interneuron that innervates only the mushroom body.")
