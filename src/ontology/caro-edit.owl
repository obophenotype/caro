AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100018> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100018> "zone D")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100018> "FBbt:00100018")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100018> "Presence of presynaptic sites determined by immunoreactivity to syntaxin and synaptobrevin::GFP localization (Kamikouchi et al., 2006).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207559") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100019> "Antennal mechanosensory and motor center zone E is a synapse-rich sub-region of the antennal mechanosensory and motor center (AMMC) that is continuous with the EA bundle. It is rich in presynaptic sites of Johnston's organ neurons (JONs). JONs innervating zone E respond tonically to posterior-directed aristal deflection (Yorozu et al., 2009), and are also involved in gravitaxis (Kamikouchi et al., 2009).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100019> "sr544")
