AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00007368> "2009-07-13T04:06:57Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007368> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007368> "FBbt:00007368")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0103328") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007369> "Precursor of the inter-ommatidial cells (secondary and tertiary pigment cells). From 10 hours after puparium formation (APF), these cells are part of an unstructured pool of undifferentiated cells surrounding each developing ommatidial core. Around 20-23 hours APF, the primary precursors leave this pool and become part of the ommatidia. Following this, the inter-ommatidial precursors and inter-ommatidial bristle precursors develop into an organized lattice surrounding the ommatidia.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00007369> "djs93")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00007369> "2009-10-01T01:13:25Z")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0103328") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007369> "IPC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007369> "interommatidial precursor cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007369> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007369> "FBbt:00007369")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007369> "DISAMBIGUATION: There are at least two uses of this term. It is usually used, as here, only to refer to precursors of the secondary and tertiary pigment cells (e.g. Miller and Cagan, 1998). But it is also sometimes used to also refer to precursors of primary pigment cells (e.g. Larson et al., 2008), even though primary pigment cells are not inter-ommatidial cells.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0103328") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007370> "Precursor of the primary pigment cells of the retina. From 10 hours after puparium formation, these cells are part of an unstructured pool of undifferentiated cells surrounding each developing ommatidial core. Around 20-23 hours APF, the primary pigment cell precursors leave this pool and become part of the ommatidia.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00007370> "djs93")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00007370> "2009-10-02T10:49:52Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007370> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007370> "FBbt:00007370")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007370> "DISSAMBIGUATION: The term inter-ommatidial precursor cell is sometimes used to refer to precursors of primary pigment cells as well as secondary and tertiary pigment cells (e.g. Larson et al., 2008), even though primary pigment cells are not inter-ommatidial cells. This is not the case here.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-521-57048-0") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007371> "A cell of the retina containing screening pigments that functions to screen photoreceptors from light leaking from adjacent ommatidia.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00007371> "djs93")
