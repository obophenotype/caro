AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00040050") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00040050> "Posterior-most synaptic neuropil domain of the midline. It is the only synaptic neuropil domain outside of the central complex that is fused across the midline. It is located behind the fan-shaped body and below the protocerebral bridge.")
