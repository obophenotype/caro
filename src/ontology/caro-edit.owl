AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0111143") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0152146") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005739> "A cluster of 4 extra-retinal photoreceptors located beneath the basement membrane, at the posterior margin of the compound eye, near to the equator. Derived from the larval Bolwig's organ.")
