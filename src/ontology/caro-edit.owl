AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007734") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00004522> "A small, sclerotized, apically pointed flap, distal to the clypeus. The oral opening is behind and at the base of this flap.")
