AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00017007> "FBbt:00017007")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00017007> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00017007> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0111405") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00017008> "This primordium first becomes distinct at around stage 11 as a group of cells at the posterior tip of the visceral mesoderm (the tail end of the germ-band). During germ-band retraction these cells migrate anteriorly and split into two clusters - one on either side of the posterior midgut primordium. When these cell reach the anterior tip of the posterior midgut primordium they disperse anteriorly as two rows along the germband. Finally, during midgut closure these cells spread regularly over the underlying circular visceral muscle primordium.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00017008> "FBbt:00000108")
