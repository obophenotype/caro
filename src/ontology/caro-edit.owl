AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001418> "FBbt:00001418")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001418> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0072659") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001419> "An unpaired neuroblast delaminating in stage 4 along the ventral midline of the CNS. It gives rise to a cluster of 5-8 cells with short bilateral projections in the anterior and posterior commissures and long fibers that enters the intersegmental nerve.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0072659") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001419> "median neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001419> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001419> "FBbt:00001419")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001419> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001419> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055900") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076117") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001420> "A neuroblast delaminating in the fifth and final wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic in late stage 11. The S5 neuroblasts delaminate into columns in between the existing intermediate and lateral columns of neuroblasts (Doe, 1992).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001420> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001420> "S5 neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001420> "FBbt:00001420")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001420> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001420> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0084809") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB2-3.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/23 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001421> "Neuroblast NB2-3 delaminates at S5. It generates three large, round axonless cells at the dorsal side of the thoracic clones which are proposed by Schmid et al., (1999) to be latent leg motorneurons that will extend axons during leg disk eversion. It also generates 2-4 small interneurons at the ventral side of the clone. In the abdominal segments only a single large neuroblast is observed at embryonic stage 17, which either does not divide or all progeny die.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001421> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055900") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001421> "NB1-2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001421> "FBbt:00001421")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001421> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001421> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB3-3.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/33description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001422> "Neuroblast NB3-3 delaminates predominantly at S4 (Schmidt et al., 1997). It generates a single motorneuron positioned midway along the dorsoventral axis, though slightly lateral and posterior. It also generates 10-18 interneurons that project across the anterior commissure (Schmid et al., 1999).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001422> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001422> "FBbt:00001422")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001422> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001422> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB4-3.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/43 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001423> "Neuroblast NB4-3 delaminates at S5. It generates 8-13 neurons, 10-12 of which are small, axonless interneurons.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001423> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001423> "FBbt:00001423")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001423> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001423> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001423> "Schmidt et al., (1997) describe this lineage as producing motorneurons that project into the SN. Contrarily, Schmid et al., (1999) suggest that the cells identified as motorneurons by Schmidt are actually neurosecretory cells of the TN.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB5-1.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/51 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001424> "Neuroblast NB5-1 delaminates at S5 in the medial column. It generates approximately 6-9 local interneurons that predominantly project across the posterior commissure (Schmid et al., 1999).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001424> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001424> "FBbt:00001424")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001424> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001424> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001424> "Schmid et al., (1999) comment that NB5-2 may give rise to a larger number of clones, including at least one motorneuron, but were not observed due to observational restrictions.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB5-5.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/55 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001425> "Neuroblast NB5-5 delaminates at S5. Thoracic and abdominal clones contain 8-11 large neurons including interneurons and neurosecretory cells.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001425> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001425> "clone Y")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001425> "FBbt:00001425")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001425> <http://purl.obolibrary.org/obo/fbbt#EmbDevSlim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001425> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001425> "Schmid et al., (1999) suggest that NB5-5 may be equivalent to clone Y described by Schmidt et al., (1997).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB7-3.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/73 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001426> "Neuroblast NB7-3 delaminates at S5. It generates the relatively small GW motorneuron, positioned on the lateral side of the clone and projects out the posterior root of the ISN. It also generates three slightly larger interneurons that project across the posterior commissure, and a small axonless cell. It may also generate a glial cell (http://www.neuro.uoregon.edu/doelab/lineages/texts/73%20description.html).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001426> "fly_anatomy.ontology")
