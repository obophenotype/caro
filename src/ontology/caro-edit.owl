AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100192> "FBbt:00100192")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100192> "That this bristle is mechanosensory is primarily based on the presence of a characteristic microtubular body present in the single innervating neuron (Palka et al., 1979).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0032909") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049554") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100193> "Chemosensory neuron that is part of a bristle of the dorsal double row.")
