AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0051437") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem2.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003983> "Tract that emerges from the antennal lobe lateral to the inner antenno-cerebral tract and extends into the lateral protocerebrum.")
