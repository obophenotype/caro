AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100103> "chemosensory dorsal triple row bristle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100103> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100103> "recurved, poly-innervated, chemosensory bristle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100103> "FBbt:00100103")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100103> "Palka et al., (1979) show that of the five dendrites innervating the wing margin chemosensory bristles, one contains a microtubular body, suggesting it to be a mechanosensory neuron. That this bristle is chemosensory in nature is based on the presence of the terminal pore and multiple innervation with dendrites extending to the pore (Palka et al., 1979).")
