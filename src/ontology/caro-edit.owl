AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-19-860917-9") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007028> "A type of epithelium that is made up of flattened cells which are arranged with their long axes in the plane of the epithelium.")
