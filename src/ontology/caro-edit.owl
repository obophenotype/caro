AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0148966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSdescription.html#ldaB") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00002426> "Multidendritic neuron in the lateral sensory cluster of larval abdominal segments 1-7. Its dendrites harbour long primary and secondary branches with many spiked protrusions (1-20um) along most of their length.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00002426> "FBbt:00002036")
