AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB3-2.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/32 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001388> "Neuroblast NB3-2 delaminates at S1 and generates as many as 6 motorneurons and a cluster if local interneurons. It is the mirror image of the clone derived from NB4-2 (http://www.neuro.uoregon.edu/doelab/lineages/NB3-2.html).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001388> "fly_anatomy.ontology")
