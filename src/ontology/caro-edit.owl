AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007454> <http://purl.obolibrary.org/obo/fbbt#olfactory_system_draft>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007454> "For image, see doi:10.1371/journal.pbio.1000461.g002.
1 adPN has been renamed to VM7v to be consistent with the change of glomerulus name from glomerulus 1 to glomerulus VM7v.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007455> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007455> "FBbt:00007455")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0183938") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007456> "An adult antennal lobe projection neuron that develops by remodelling of larval antennal lobe projection neuron. Both axons and dendrites of these neurons are extensively remodelled during metamorphosis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FBbt_00007456> "persistent projection neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007456> "VFB:FBbt_00007456")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0183938") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007456> "PPN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007456> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007456> "FBbt:00007456")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0201640") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007457> "Larval neurosecretory neuron that secretes prothoracicotropic hormone (FBgn0013323; McBrayer et al., 2007) and innervates the prothoracic gland. The somata of these neurons (2 per hemisphere) lie in the cortex of the lateral protocerebrum. Their axons, which form extensive collaterals in the brain, run along the anterior brain at the cortex/neuropil interface before traversing the midline and entering the contralateral nervus corporis cardiaci through which they travel to the ring gland. Within the ring gland these axons bypass the corpora cardiaca to innervate the prothoracic gland where they arborize extensively.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0201640") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007457> "PG neuron")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007457> "PG-LP")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007457> "Prothoracic gland innervating neurosecretory neuron of the lateral protocerebrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007457> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007457> "FBbt:00007457")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007457> "McBrayer et al., (2007) used enhancer trap expression to confirm that their PG neurons are identical to the PG-LP neurons identified by Siegmund and Korge (2001).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007458> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007458> "PG neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007458> "FBbt:00007458")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007459> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007459> "larval CA neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007459> "FBbt:00007459")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007460> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007460> "larval CC neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007460> "FBbt:00007460")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007461> "Larval neurosecretory neuron whose soma is located in the cortex of the antero-dorsal region of the lateral protocerebrum and whose axon innervates the corpora allatum. This axon runs caudally on a slightly curved path from to the nervus corporis cardiaci (NCC). It emerges from the NCC at the ring gland and passes the copora cardiaca and the lateral limb of the prothoracic gland before innervating the corpora allatum. There is only one bilaterally symmetric pair of these cells per animal.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007461> "CA-LP 1")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007461> "Corpus allatum innervating neurosecretory neuron of the lateral protocerebrum 1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007461> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007461> "FBbt:00007461")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007461> "Recorded as neurosecretory because Siegmund and Korge (2001) say so. Assume this is implied from its innervation of the corpus allatum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007462> "Bilaterally paired, larval neurosecretory neuron whose soma is located in the cortex of the lateral protocerebrum and whose axon innervates the corpora allatum. Their axons follow an anterior path towards the mushroom bodies and the soma of CA-LP 1, where they split. One branch follows the same path as the axon of corpus allatum neuron CA-LP 1 to the corpus allatum via the nervus corporis cardiaci (NCC). The other branch runs towards the midline. There are only two of these cells per hemisphere.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007462> "CA-LP 2")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007462> "Corpus allatum innervating neurosecretory neuron of the lateral protocerebrum 2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007462> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007462> "FBbt:00007462")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007462> "Recorded as neurosecretory because Siegmund and Korge (2001) say so. Assume this is implied from its innervation of the corpus allatum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007463> "Larval neurosecretory neuron whose soma is located in the pars-intercerebralis and whose axon innervates the corpus cardiacum and the aorta. They each project caudally along the midline. At a distance of about 50 micrometres from the soma, the projection splits: one branch follows the midline down to the subesophageal ganglion, and the second branch crosses the midline, enters the contralateral nervus corporis cardiaci (NCC), and arborizes in the corpus cardiacum, extending further along the aorta.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007463> "CC/A-PI")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007463> "corpus cardiacum innervating neurosecretory neuron of the pars intercerebralis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007463> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007463> "FBbt:00007463")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007463> "Recorded as neurosecretory because Siegmund and Korge (2001) say so. Assume this is implied from its innervation of the corpus cardiacum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007464> "Larval neurosecretory neuron that is not octopaminergic and whose soma is located in the pars-intercerebralis and whose axon innervates the corpus cardiacum and the aorta. There are two of these per animal.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007464> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007464> "FBbt:00007464")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007465> "Larval neurosecretory neuron whose soma is located in the cortex of the lateral protocerebrum and whose axon innervates the corpus cardiacum. The soma of these neurons are located in 2 clusters of seven (one per hemisphere), between CA-LP1 an CA-LP2.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007465> "CC-LP")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007465> "corpus cardiacum innervating neurosecretory neuron of the lateral protocerebrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007465> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007465> "FBbt:00007465")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007465> "Recorded as neurosecretory because Siegmund and Korge (2001) say so. Assume this is implied from its innervation of the corpus cardiacum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007466> "Serotonergic neuron that fasciculates with the nervus corporis cardiaci and arborizes in the corpus cardiacum and along the aorta.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007466> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007466> "FBbt:00007466")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007466> "The origin of these fibers is most likely the ventricular ganglion (Siegmund and Korge, 2001).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007467> "Octopaminergic larval neurosecretory neuron whose soma is located in the pars-intercerebralis and whose axon innervates the corpus cardiacum and the aorta. There are six of these per animal.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007467> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007467> "FBbt:00007467")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007467> "Believed to be octopaminergic on the basis of tryamine beta hydroxylase expression (Siegmund and Korge, 2001).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007468> "Larval neurosecretory neuron whose soma is located in the cortex of the medial subesophageal ganglion, directly below the esophagus and whose axon innervates the corpus cardiacum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007468> "CC-MS 1")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007468> "corpus cardiacum innervating neurosecretory neuron of the medial subesophageal ganglion 1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007468> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007468> "FBbt:00007468")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007468> "Recorded as neurosecretory because Siegmund and Korge (2001) say so. Assume this is implied from its innervation of the corpus cardiacum.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007469> "Larval neurosecretory neuron whose soma is located in the posteriorly in the cortex of the medial subesophageal ganglion and whose axon innervates the corpus cardiacum (CC). Its axon runs on an outwardly curved path toward the dorsal mid-line, crosses it, and joins the axons of the CC-MS 1 on their way to the CC.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134726") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007469> "CC-MS 2")
