AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB3-1.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/31 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001394> "Neuroblast NB3-1 delaminates at S3 in the medial column of neuroblasts. It generates the well characterized RP1 (FBbt:00001452), RP3 (FBbt:00001455), RP4 (FBbt:00001456) and RP5 (FBbt:00001457) motorneurons and a cluster of intersegmental interneurons. It also generates a variable number of local of local interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB3-1.html).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001394> "fly_anatomy.ontology")
