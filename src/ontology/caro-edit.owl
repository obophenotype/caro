AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055900") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076117") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001393> "A neuroblast delaminating in the third wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic stage 10 and end during stage 11, and the neuroblasts generally delaminate into the medial and lateral edge of the neuroblast array (Doe, 1992).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001393> "fly_anatomy.ontology")
