AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem3.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/horizschem1.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007053> "Dorso-lateral most synaptic neuropil domain of the adult midbrain. This horn-like projection houses the terminals of various antennal lobe projection neurons. It is not separated from other neuropils by a glial sheath, but by the extent of arborization and synapsing of these antennal lobe projection neurons.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007053> "VFB:FBbt_00007053")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007053> "LH")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007053> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007053> "FBbt:00007053")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007053> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00045031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem2.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/sagschem2.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007054> "Lateral synaptic neuropil domain of the superior neuropils. It lies behind the anterior optic tubercle, in front of the mushroom body calyx and above the superior clamp and lateral horn. Its boundary with the anterior optic tubercle (AOTU) is demarcated by the extent of arborization of visual projection neurons within the AOTU and with the lateral horn by the extend of arborization of antennal lobe projection neurons.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00007054> "FBbt:00045031")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007054> "VFB:FBbt_00007054")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007054> "SLP")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007054> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007054> "adult superior lateral protocerebrum")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193607") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007054> "slpr")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007054> "FBbt:00007054")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007054> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007054> "Boundaries defined by BrainName (used to define this term) differ slightly from those defined for slpr in Otsuna and Ito, 2006.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH-AJ") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00007055") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/horizschem1.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007055> "Medial synaptic neuropil domain of the superior neuropils that lies above the area flanked by the mushroom lobes, pedunculus, and calyx. It is separated from the pedunculus by the superior clamp. The fan-shaped body protrudes deeply into this neuropil, separating it into anterior and posterior regions.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007055> "VFB:FBbt_00007055")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007055> "SMP")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0212889") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007055> "smpr")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007055> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007055> "FBbt:00007055")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007055> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH-AJ") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/sagschem2.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007056> ".")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00007056> "FBbt:00040037")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007056> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007056> "FBbt:00007056")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007056> "Obsoleted in the processes of making the ontology consistent with BrainName. Mapping to BrainName domains is quite complicated. adult inferior lateral protocerebrum as defined by Otosuna and Ito (2006) overlaps BrainName regions: crepine; superior clamp; inferior clamp; superior intermediate protocerebrum; superior medial protocerebrum, bulb, antler (BrainName, 2011).")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FBbt_00007056> "true"^^xsd:boolean)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH-AJ") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/sagschem1.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007057> ".")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00007057> "FBbt:00007054")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00007057> "FBbt:00040048")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193607") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007057> "ilpr")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007057> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007057> "FBbt:00007057")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007057> "Obsoleted in the processes of making the ontology consistent with BrainName. Mapping to BrainName domains is quite complicated. adult inferior lateral protocerebrum as defined by Otosuna and Ito (2006) overlaps BrainName regions: superior clamp; superior lateral protocerebrum; a small parts of the posterior ventrolateral protocerebrum (PVLP) and the posteriorlateral protocerebrum (SLP) (BrainName, 2011).")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FBbt_00007057> "true"^^xsd:boolean)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH-AJ") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem1.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007058> "A mass of synaptic neuropil domains in the anterior brain, between the antennal lobe and the optic lobe.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007058> "VFB:FBbt_00007058")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007058> "VLP")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007058> "ventro-lateral adult protocerebrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007058> "ventro-lateral protocerebrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007058> "vlpr")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007058> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007058> "FBbt:00007058")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007058> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007058> "Currently some uncertainty about whether this is truly protocerebral - may actually be part of deuterocerebrum (Strausfeld has characterized it as such). This should be clarified as a result of Volker Hartenstein's lineage mapping work.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00007059") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://flybrain.neurobio.arizona.edu/Flybrain/html/module/1997/descdn/index.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007059> "Synaptic neuropil domain of the adult protocerebrum that receives extensive arborizations from visual projection neurons from the lobula and the medulla, projecting via the anterior optic tract. It protrudes from the anterior-most area of the ventro-lateral neuropils and is slightly detached from the ventro-lateral protocerebrum.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007059> "VFB:FBbt_00007059")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007059> "AOTU")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007059> "OTU")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007059> "optic tubercle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007059> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007059> "FBbt:00007059")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007059> <http://purl.obolibrary.org/obo/fbbt#BrainName>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007059> "Otsuna and Ito (2006) suggest that the optic tubercle may be divided into three regions according to the density of arborizations. The medial-most (optu1) and lateral-most (optu3) contain dense arborizations of the Lcn10 neurons, whilst the area between these regions (optu2) is essentially devoid of the lobula columnar neurons.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007060> "A structure consisting of multiple cell components but which is not itself a cell and does not have (complete) cells as a part.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007060> "CARO:0001000")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007060> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007060> "FBbt:00007060")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007060> <http://purl.obolibrary.org/obo/fbbt#larval_OF>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH-JR") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007061> ".")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/FBbt_00007061> "FBbt:00003626")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007061> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007061> "FBbt:00007061")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007061> "Obsoleted in the processes of making the ontology consistent with BrainName. This term was never properly defined, so no precise replacement term can be suggested.")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/FBbt_00007061> "true"^^xsd:boolean)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007063> "One of a group of synaptic neuropil domains of the larval brain which are located ventral to the mushroom body and are grouped around the long axon tracts connecting the larval protocerebrum to the ventral nerve cord. This medially located compartment contacts the baso-anterior compartment (BA) posteriorly. The lateral cervical tract ascends through the center of this compartment.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007063> "larval baso-posterior midbrain")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007063> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007063> "BPM")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007063> "FBbt:00007063")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007063> "Note - description of relative location of brain structures in this definition is based on Younossi-Hartenstein et al., 2003, description of the first instar larval brain. As there is some non-isometric growth of compartments during larval stages, some elements of this description may not apply to the third instar larval brain. ds080222.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007064> "A synaptic neuropil domain of the larval brain that forms during the third instar from a dorsal region of the centro-posterior lateral compartment by growth of a neuropil glial sheath across it.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007064> "dorsal centro-posterior lateral synaptic neuropil domain")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007064> "larval lateral horn")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007064> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007064> "CPLd")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007064> "FBbt:00007064")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00007064> <http://purl.obolibrary.org/obo/fbbt#larval_OF>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007064> "Developmental relation to adult synaptic neuropil domains comes from a personal communication from Volker Hartenstein. Note - description of relative location of brain structures in this definition is based on Younossi-Hartenstein et al., 2003, description of the first instar larval brain. As there is some non-isometric growth of compartments during larval stages, some elements of this description may not apply to the third instar larval brain. ds080222.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007065> "A synaptic neuropil domain of the larval brain that is located dorsal to the medial lobe of the mushroom body, and which is separated from the dorso-posterior compartment by a neuropil glial sheath slightly posterior to the vertical lobe of the mushroom body.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007065> "DA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007065> "dorso-anterior synaptic neuropil compartment")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007065> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007065> "FBbt:00007065")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007065> "Developmental relation to adult synaptic neuropil domains comes from a personal communication from Volker Hartenstein. Note - description of relative location of brain structures in this definition is based on Younossi-Hartenstein et al., 2003, description of the first instar larval brain. As there is some non-isometric growth of compartments during larval stages, some elements of this description may not apply to the third instar larval brain. ds080222.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007066> "A synaptic neuropil domain of the larval brain that is located dorsal to the medial lobe of the mushroom body and which is separated from the dorso-anterior compartment by a neuropil glial sheath slightly posterior to the vertical lobe of the mushroom body. Axons from this compartment converge with those from the centro-posterior lateral compartment (CPL) to form the posterior transverse tract (PTT).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007066> "DP")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007066> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007066> "FBbt:00007066")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007066> "Developmental relation to adult synaptic neuropil domains comes from a personal communication from Volker Hartenstein. Note - description of relative location of brain structures in this definition is based on Younossi-Hartenstein et al., 2003, description of the first instar larval brain. As there is some non-isometric growth of compartments during larval stages, some elements of this description may not apply to the third instar larval brain. ds080222.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007067> "One of a group of synaptic neuropil domains of the larval brain which are located ventral to the mushroom body and are grouped around the long axon tracts connecting the larval protocerebrum to the ventral nerve cord. This medially located compartment contacts the baso-anterior compartment (BA) posteriorly.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007067> "BC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007067> "baso-central synaptic neuropil domain")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007067> "centro-posterior medial neuropil compartment")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007067> "larval ventral body")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007067> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007067> "FBbt:00007067")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007067> "Note - description of relative location of brain structures in this definition is based on Younossi-Hartenstein et al., 2003, description of the first instar larval brain. As there is some non-isometric growth of compartments during larval stages, some elements of this description may not apply to the third instar larval brain. ds080222.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:VH") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155900") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007068> "One of a group of synaptic neuropil domains of the larval brain which are located ventral to the mushroom body and are grouped around the long axon tracts connecting the larval protocerebrum to the ventral nerve cord. This compartment contacts the baso-anterior compartment (BA) posteriorly, and is lateral to the baso-central (BC) and baso-posterior medial (BPM) compartments. It grows anteriorly during larval development.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007068> "BPL")
