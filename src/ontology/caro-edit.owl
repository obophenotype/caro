SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001001> <http://purl.obolibrary.org/obo/CARO_0001000>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0002309>))

# Class: <http://purl.obolibrary.org/obo/CARO_0001002> (anatomical surface)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001002> "A two dimensional anatomical structure that is the boundary between an anatomical structure and an anatomical substance, an anatomical space or the organism's environment.  Examples include the surface of your skin, the surface of the lining of your gut; the surface of the endothelium of you aorta that is in contact with blood.
"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CARO_0001002> "CARO:0000010")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001002> "Old definition: \"Non-material anatomical entity of two dimensions, that is demarcated by anatomical lines or points on the external or internal surfaces of anatomical structures.\"  Note, in the new definition, the space referred to is not necessarily an anatomical space.  It may be the outside of an organism."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001002> "anatomical surface")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001002> <http://purl.obolibrary.org/obo/CARO_0001007>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001003> (fiat anatomical boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001003> "A  two dimensional anatomical entity that does not correspond to any physical discontinuity."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001003> "Fiat anatomical boundaries are generally defined using external physical criteria as landmarks.  One might argue that all boundaries are actually fiat in the sense that there must be some fiat element at a fine enough scale of granularity.  This ontology choses to ignore this issue as below the level of granularity relevant to anatomy. (DOS121102)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001003> "fiat anatomical boundary"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001003> <http://purl.obolibrary.org/obo/CARO_0000010>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001004> (bona-fide anatomical boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001004> "An anatomical boundary that corresponds to some physical discontinuity."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001004> "One might argue that all boundaries are actually fiat in the sense that there must be some fiat element at a fine enough scale of granularity.  This ontology choses to ignore this issue as below the level of granularity relevant to anatomy. (DOS121102)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001004> "bona-fide anatomical boundary"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001004> <http://purl.obolibrary.org/obo/CARO_0000010>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001005> (gene expression boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001005> "A two dimensional anatomical entity that is the boundary of a domain of  expression of some gene."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001005> "gene expression boundary"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001005> <http://purl.obolibrary.org/obo/CARO_0001004>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001006> (developmental compartment boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001006> "A two dimensional anatomical entity that is not a morphological boundary and that cells do not cross during development."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001006> "developmental compartment boundary"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001006> <http://purl.obolibrary.org/obo/CARO_0001004>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001007> (morphological boundary)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001007> "A two dimensional anatomical structure that corresponds to some structural discontinuity."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001007> "morphological boundary"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001007> <http://purl.obolibrary.org/obo/CARO_0001004>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001008> (gross anatomical part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001008> "Anatomical structure that is part of a multicellular organism and is at the gross anatomical level, e.g. above the level of a cell.  Included are portions of organism substances such as blood, multi-cell-part structures such as axon tracts, acellular anatomical structures such as hair, and organism subdivisions such as head. Excluded is the whole organism and more granular parts of the organism, such as atoms, molecules, macromolecular complexes and cells. ")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0001008> <https://orcid.org/0000-0001-9114-8737>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0001008> "10.7.2011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CARO_0001008> <http://purl.obolibrary.org/obo/caro#plus>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001008> "gross anatomical part"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/CARO_0001008> ObjectUnionOf(<http://purl.obolibrary.org/obo/CARO_0000004> <http://purl.obolibrary.org/obo/CARO_0000032> <http://purl.obolibrary.org/obo/CARO_0000040> <http://purl.obolibrary.org/obo/CARO_0000042> <http://purl.obolibrary.org/obo/CARO_0001000> <http://purl.obolibrary.org/obo/CARO_0010000>))
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001008> <http://purl.obolibrary.org/obo/CARO_0000006>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001008> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/CARO_0000012>))

# Class: <http://purl.obolibrary.org/obo/CARO_0001009> (obsolete anatomical chamber)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001009> "Anatomical structure that surrounds an immaterial anatomical entity.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0001009> <https://orcid.org/0000-0001-9114-8737>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0001009> "10.10.2011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CARO_0001009> <http://purl.obolibrary.org/obo/caro#plus>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001009> "See CARO tracker #6, but essentially Chamber has connotations of space, rather than wall: see http://en.wiktionary.org/wiki/chamber

This term is extremely abstract as a genus - it specifies no granularity at all. It could refer to a chamber in a protein complex in a membrane as easily as some big multi-tissue structure like a segment of gut.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001009> "obsolete anatomical chamber")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/CARO_0001009> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/CARO_0001010> (organism)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001010> "Material anatomical entity that is a member of an individual species or is a viral or viroid particle.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0001010> "Melissa Haendel")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0001010> "9/18/11")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CARO_0001010> "organism or virus or viroid")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001010> "organism")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001010> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001013> (anatomical plane)

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001013> "All anatomical planes are fiat anatomical boundaries - no morphological boundary could ever be a perfect plane.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001013> "anatomical plane")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001013> <http://purl.obolibrary.org/obo/CARO_0001003>)

# Class: <http://purl.obolibrary.org/obo/CARO_0001500> (neuron projection bundle segment)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001500> "A fiber-shaped subdivision of a neuron projection along its long axis."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001500> "neuron projection bundle segment"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001500> <http://purl.obolibrary.org/obo/CARO_0001000>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001500> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/CARO_0001001>))
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001500> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0002309>))

# Class: <http://purl.obolibrary.org/obo/CARO_0001501> (neuron projection bundle subsegment)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0001501> "A subdivision of a neuron projection along its long axis that is as long as it is wide (and so does not qualify as fiber-shaped)."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0001501> "This term was added in order to define fasciculation relations.  It seems unlikely that it will be used directly in curation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0001501> "neuron projection bundle subsegment"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001501> <http://purl.obolibrary.org/obo/CARO_0001000>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001501> ObjectComplementOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0002309>)))
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0001501> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/CARO_0001001>))

# Class: <http://purl.obolibrary.org/obo/CARO_0002000> (epidermis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002000> "Epithelium of the integumentary system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002000> "epidermis")
EquivalentClasses(<http://purl.obolibrary.org/obo/CARO_0002000> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CARO_0000066> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/CARO_0002001>)))

# Class: <http://purl.obolibrary.org/obo/CARO_0002001> (integumentary system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002001> "Connected anatomical system that forms a barrier between an animal and its environment - generally consisting of an epidermis, which may be covered by some acellular structure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002001> "integumentary system")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002001> <http://purl.obolibrary.org/obo/CARO_0000011>)

# Class: <http://purl.obolibrary.org/obo/CARO_0002002> (aligned anatomical group)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002002> "An anatomical group whose members are arranged in a line.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0002002> "Examples include the rows of sense organs commonly found in the cuticles of insects.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002002> "aligned anatomical group")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002002> <http://purl.obolibrary.org/obo/CARO_0020000>)

# Class: <http://purl.obolibrary.org/obo/CARO_0002003> (clustered anatomical group)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002003> "Anatomical group whose parts are close together, forming a cluster.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0002003> "Not to be confused with anatomical cluster, in the FMA sense.  FMA anatomical structures are connected structures made up of heterologous parts.  For example, joints are anatomical clusters in the FMA.  The FMA definition on anatomical cluster, and the CARO1 definition that was based on it, are defined largely by exclusion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002003> "clustered anatomical group"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002003> <http://purl.obolibrary.org/obo/CARO_0020000>)

# Class: <http://purl.obolibrary.org/obo/CARO_0002004> (segment body)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002004> "One of a set of semi-repetitive organism subdivisions serially arranged along the anterior-posterior axis of an organism and excluding appendages if present.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002004> "segment body")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002004> <http://purl.obolibrary.org/obo/CARO_0000032>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002004> ObjectComplementOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/CARO_0010003>)))

# Class: <http://purl.obolibrary.org/obo/CARO_0002005> (appendage subdivision)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002005> "A subdivision of an appendage along its proximal-distal axis, consisting consisting of components of multiple anatomical systems, largely surrounded by a contiguous region of integument.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002005> "appendage subdivision"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002005> <http://purl.obolibrary.org/obo/CARO_0000032>)

# Class: <http://purl.obolibrary.org/obo/CARO_0002006> (obsolete body cavity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/CARO_0002006> "Ceolom, cranial cavity, mammalian thoracic and abdominal body cavities, arthropod hemoceol.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002006> "A major anatomical space of an organism in which major organs are located.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002006> "obsolete body cavity")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/CARO_0002006> "true"^^xsd:boolean)

# Class: <http://purl.obolibrary.org/obo/CARO_0002100> (anatomical system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002100> "An anatomical structure consisting of multiple cells, organs, tissues, distributed throught an organism, that act together to perform some physiological function.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) rdfs:comment <http://purl.obolibrary.org/obo/CARO_0002100> "Examples include connected systems such as the circulatory system - whose elements function together to perform the function or blood circulation - and disconected systems such as the immune system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002100> "anatomical system")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002100> <http://purl.obolibrary.org/obo/CARO_0000000>)

# Class: <http://purl.obolibrary.org/obo/CARO_0002101> (disconnected anatomical system)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-7073-9172>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0002101> "An anatomical system consisting of multiple disconnected parts.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0002101> "Examples include the immune system and the endocrine system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0002101> "disconnected anatomical system")
EquivalentClasses(<http://purl.obolibrary.org/obo/CARO_0002101> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CARO_0002100> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0010001>) ObjectMinCardinality(2 <http://purl.obolibrary.org/obo/RO_0002180> <http://purl.obolibrary.org/obo/CARO_0000003>)))
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0002101> <http://purl.obolibrary.org/obo/CARO_0002100>)

# Class: <http://purl.obolibrary.org/obo/CARO_0010000> (multicellular anatomical structure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0010000> "An anatomical structure that has more than one cell as a part.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0010000> "djs93")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0010000> "Sun Feb 27 10:53:00 GMT 2011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CARO_0010000> "CARO:0010000")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CARO_0010000> <http://purl.obolibrary.org/obo/caro#core>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0010000> "multicellular anatomical structure")
EquivalentClasses(Annotation(rdfs:comment "There is a cost to burying this in PATO.  We lose that we could relax the cardinality assertion to subClassOf has_part some cell.  I'm sure having this axiom inherited would come in handy.  DOS") <http://purl.obolibrary.org/obo/CARO_0010000> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CARO_0000003> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0001993>)))

# Class: <http://purl.obolibrary.org/obo/CARO_0010001> (cell cluster organ)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0010001> "A small cluster of cells of various types which form a discrete structure, largely delimited by a morphological boundary and whose components work together to make the whole structure capable of a specific function.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0010001> "djs93")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0010001> "Sun Feb 27 11:00:35 GMT 2011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CARO_0010001> "CARO:0010001")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0010001> "Examples include arthropod sensilla.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0010001> "cell cluster organ")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0010001> <http://purl.obolibrary.org/obo/CARO_0020002>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0010001> <http://purl.obolibrary.org/obo/CARO_0020004>)
DisjointClasses(<http://purl.obolibrary.org/obo/CARO_0010001> <http://purl.obolibrary.org/obo/CARO_0010002>)

# Class: <http://purl.obolibrary.org/obo/CARO_0010002> (compound cell cluster organ)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0010002> "An anatomical structure consisting of multiple cell cluster organs, largely delimited by a morphological boundary and whose components work together to make the whole structure capable of a specific function.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0010002> "djs93")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0010002> "Sun Feb 27 11:13:17 GMT 2011")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CARO_0010002> "CARO:0010002")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CARO_0010002> "Examples: compound eye; Johnston's organ.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CARO_0010002> "compound cell cluster organ")
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0010002> <http://purl.obolibrary.org/obo/CARO_0020004>)
SubClassOf(<http://purl.obolibrary.org/obo/CARO_0010002> ObjectMinCardinality(2 <http://purl.obolibrary.org/obo/RO_0002180> <http://purl.obolibrary.org/obo/CARO_0010001>))

# Class: <http://purl.obolibrary.org/obo/CARO_0010003> (appendage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CARO_0010003> "An organism subdivision that protrudes from the body."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/CARO_0010003> "djs93")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_creation_date> <http://purl.obolibrary.org/obo/CARO_0010003> "Fri Mar 04 07:09:17 GMT 2011")
