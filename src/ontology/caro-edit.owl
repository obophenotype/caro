AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/neuro/gp.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001405> "Unlike the other neuroblasts, the glial precursor (GP) does not divide to make GMCs or neurons. Dividing roughly symmetrically during embryonic stage 11, it produces two cells that eventually divide to generate six longitudinal glia.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/neuro/gp.html") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001405> "GP")
