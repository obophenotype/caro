AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007083> "From Strausfeld (ISBN:978-3-540-07343-7) pg 99 in Musca Domestica. Confirmed as present in Drosophila melanogaster by VH.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:DOS-VH") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007084> "An axon tract that crosses the midline.")
