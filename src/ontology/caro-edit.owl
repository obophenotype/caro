AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007328> "Dorsally directed branch of segmental nerve of larval A1-7. It innervates the lateral transverse and oblique muscles and carries axons of sensillum vc5 (also known as vp5) and lch1.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00007328> "david")
