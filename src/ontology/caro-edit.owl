AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100498> "The existence of this neuroblast is inferred from lineage data (Pereanu et al., 2011; Pereanu and Hartenstein, 2006). These papers study secondary neuroblast divisions. Although all of these lineages will correspond to a lineage from a known primary neuroblast lineage, only some will correspond to lineages from the secondary neuroblast division.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206543") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100499> "Glial cell that is part of the adult central nervous system.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100499> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100499> "2011-04-26T02:22:14Z")
