AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100131> "female genital gustatory sensillum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100131> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100131> "FBbt:00100131")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100131> "Note: currently there is no direct evidence that these neurons are definitely chemosensory. That they are likely to be chemosensory in nature is based on their morphology (Taylor, 1989), that they are multiply innervated (Taylor, 1989), and behavioural observations of the animals during egg laying (Yang et al., 2008).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0068700") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100132> "Gustatory neuron innervating a mesothoracic leg taste bristle. There are between 2 and 4 per bristle (Stocker 1994).")
