AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0155902") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0209907") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110059> "Adult neuron that expresses leucokinin (FBgn0028418) and whose cell body is located superficially in the posterior side of the median protocerebrum (de Haro et al., 2010).")
