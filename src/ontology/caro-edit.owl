AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0098344") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001404> "Neuroblast located at the embryonic segment border close to the tracheal pit and produces both neurons and glial cells (Schmidt et al., 1997).")
