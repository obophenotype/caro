AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0084809") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/NB2-2.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.neuro.uoregon.edu/doelab/lineages/texts/22 description.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001385> "Neuroblast NB2-2 delaminates at S2 and generates two to three motorneurons that innervate anterior lateral muscles via the SNa. It generates a large number of local interneurons and a smaller number of late-developing intersegmental interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB2-2.html).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001385> "fly_anatomy.ontology")
