AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0075072") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00002687> "Sensillum of the lateral part of the embryonic/larval dorsal pouch (Campos-Ortega and Hartenstein, 1997). It contains a single neuron (first seen at embryonic stage 15) that is located dorsal to Bolwig's nerve (at stages 16-17) and fasciculates with the lateropharyngeal nerve (SN-V).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00002687> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00002687> "apo")
