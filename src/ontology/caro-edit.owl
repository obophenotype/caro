AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0050677") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0085956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0108300") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSdescription.html#dbd") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00002442> "Bipolar multidendritic neuron in the dorsal sensory cluster of larval abdominal segments 1-7. It emits two longitudinal dendritic branches along dorsal acute muscle 3 (Williams and Shepherd, 1999), and fasciculates with the intersegmental nerve (Campos-Ortega and Hartenstein, 1997).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.normalesup.org/~vorgogoz/FlyPNS/PNSdescription.html#dbd") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FBbt_00002442> "dbd")
