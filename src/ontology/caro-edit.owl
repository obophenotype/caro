AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#BRAIN_NAME_ABV>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100337> "AOT")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100337> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100337> "FBbt:00100337")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100337> "Fischbach and Lyly-Hunerberg, (1983), subdivide the anterior optic tract (AOT) into four sub-bundles: S1-S4. S1 consists of 100-110 think axons surrounded by ~60 large diameter neurons that form the S2 bundle. These bundles together occupy the proximal part of the AOT close to the neuropil of the lateral protocerebrum. S3 forms the lateral ventral part of the AOT and is formed by ~430 axons of small diameter that project into the anterior optic foci. S4 is composed of approximately 660 relatively small fibers.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:BrainName") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100338> "Tract emerging from the superior-most lateral area of the superior medial protocerebrum and ending in between the superior lateral protocerebrum and lateral horn.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/FBbt_00100338> "sr544")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/FBbt_00100338> "2010-11-30T12:57:17Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100338> "VFB:FBbt_00100338")
